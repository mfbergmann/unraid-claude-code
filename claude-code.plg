<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "claude-code">
  <!ENTITY author    "mfbergmann">
  <!ENTITY version   "2026.04.04">
  <!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY pluginURL "https://raw.githubusercontent.com/mfbergmann/unraid-claude-code/main/claude-code.plg">
  <!ENTITY icon      "https://raw.githubusercontent.com/mfbergmann/unraid-claude-code/main/claude-icon.png">
  <!ENTITY support   "https://github.com/mfbergmann/unraid-claude-code/issues">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;"
        support="&support;"
        icon="&icon;"
        min="6.12.0">

<CHANGES>
###2026.04.04
- Complete rewrite following Unraid community plugin conventions
- Persistent Claude Code binary cached on array (survives reboots)
- Persistent authentication and config via appdata symlinks
- Web UI settings page under Settings &gt; Utilities
- Automatic install on boot via rc.d startup script
- Auto-detection of appdata path from Docker config
</CHANGES>

<DESCRIPTION>
Claude Code CLI - AI-powered coding assistant from Anthropic.
Use Claude directly in your Unraid terminal for code generation, debugging, and more.
Authentication and settings persist across reboots automatically.
</DESCRIPTION>

<!--
================================================================================
  Plugin directory setup (runs on every plugin install/boot)
================================================================================
-->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plugin;
mkdir -p &plugdir;
</INLINE>
</FILE>

<!--
================================================================================
  Default configuration (created only if not already present)
================================================================================
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
if [ ! -f /boot/config/plugins/claude-code/claude-code.cfg ]; then
    echo 'APPDATA_PATH=""' > /boot/config/plugins/claude-code/claude-code.cfg
fi
]]>
</INLINE>
</FILE>

<!--
================================================================================
  Install script - handles Claude Code installation and persistence
================================================================================
-->
<FILE Name="&plugdir;/scripts/install.sh" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
#
# Claude Code installer for Unraid
# Handles: binary install, caching, symlink persistence
#

PLUGIN_NAME="claude-code"
PLUGIN_CFG="/boot/config/plugins/${PLUGIN_NAME}/${PLUGIN_NAME}.cfg"
CLAUDE_CONFIG_DIR="/root/.claude"
CLAUDE_CONFIG_JSON="/root/.claude.json"
LOG="/var/log/${PLUGIN_NAME}-install.log"

log() { echo "[$(date '+%H:%M:%S')] $*"; }

# --- Load configuration ---
APPDATA_PATH=""
[ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"

# --- Auto-detect appdata path if not configured ---
detect_appdata() {
    # Try Docker config first
    if [ -f "/boot/config/docker.cfg" ]; then
        local docker_appdata
        docker_appdata=$(grep -E '^DOCKER_APP_CONFIG_PATH=' /boot/config/docker.cfg 2>/dev/null | cut -d'"' -f2)
        if [ -n "$docker_appdata" ] && [ -d "$(dirname "$docker_appdata")" ]; then
            APPDATA_PATH="${docker_appdata%/}/${PLUGIN_NAME}"
            log "Detected appdata from Docker config: $APPDATA_PATH"
            return 0
        fi
    fi

    # Search common locations
    for candidate in /mnt/user/appdata /mnt/cache/appdata; do
        if [ -d "$candidate" ]; then
            APPDATA_PATH="$candidate/${PLUGIN_NAME}"
            log "Found appdata directory: $APPDATA_PATH"
            return 0
        fi
    done

    # Fallback
    APPDATA_PATH="/mnt/user/appdata/${PLUGIN_NAME}"
    log "Using default appdata path: $APPDATA_PATH"
}

if [ -z "$APPDATA_PATH" ]; then
    detect_appdata
    # Persist the detected path so it's consistent on future boots
    echo "APPDATA_PATH=\"$APPDATA_PATH\"" > "$PLUGIN_CFG"
fi

CACHED_BINARY="$APPDATA_PATH/bin/claude"

# --- Wait for a mount point to become available ---
wait_for_mount() {
    local mount_point="$1"
    local max_wait="${2:-120}"
    local waited=0

    while [ $waited -lt $max_wait ]; do
        if mountpoint -q "$mount_point" 2>/dev/null; then
            log "$mount_point is available."
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
    done
    log "WARNING: $mount_point not available after ${max_wait}s"
    return 1
}

# --- Ensure /usr/local/bin/claude symlink exists ---
ensure_symlink() {
    [ -x /usr/local/bin/claude ] && return 0
    for candidate in /root/.local/bin/claude /root/.claude/local/bin/claude; do
        if [ -x "$candidate" ]; then
            ln -sf "$candidate" /usr/local/bin/claude
            log "Symlinked $candidate -> /usr/local/bin/claude"
            return 0
        fi
    done
    return 1
}

# --- Restore binary from appdata cache ---
restore_from_cache() {
    if [ -f "$CACHED_BINARY" ]; then
        log "Restoring Claude Code from cache..."
        mkdir -p /root/.local/bin
        cp "$CACHED_BINARY" /root/.local/bin/claude
        chmod +x /root/.local/bin/claude
        return 0
    fi
    return 1
}

# --- Cache binary to appdata for next boot ---
cache_binary() {
    local src=""
    for candidate in /root/.local/bin/claude /root/.claude/local/bin/claude; do
        [ -x "$candidate" ] && src="$candidate" && break
    done
    if [ -n "$src" ]; then
        mkdir -p "$(dirname "$CACHED_BINARY")"
        cp "$src" "$CACHED_BINARY"
        log "Cached Claude binary to $CACHED_BINARY"
    fi
}

# --- Install Claude Code ---
install_claude() {
    log "=== Claude Code Installation ==="

    # Already installed and working?
    local ver
    ver=$(claude --version 2>/dev/null)
    if [ -n "$ver" ]; then
        log "Claude Code already installed: $ver"
        ensure_symlink
        return 0
    fi

    # Try cache first (fast, no network needed)
    if restore_from_cache; then
        ensure_symlink
        ver=$(claude --version 2>/dev/null)
        if [ -n "$ver" ]; then
            log "Claude Code restored from cache: $ver"
            return 0
        fi
        log "Cached binary didn't work, falling back to installer..."
    fi

    # Full install via official installer
    log "Installing Claude Code via official installer..."
    local installer
    installer=$(mktemp /tmp/claude-install.XXXXXX)

    if ! curl -fsSL https://claude.ai/install.sh -o "$installer"; then
        log "ERROR: Failed to download installer."
        rm -f "$installer"
        return 1
    fi

    if ! bash "$installer"; then
        log "ERROR: Installer script failed."
        rm -f "$installer"
        return 1
    fi
    rm -f "$installer"

    ensure_symlink
    cache_binary

    if command -v claude &>/dev/null; then
        log "Claude Code installed successfully: $(claude --version 2>/dev/null)"
    else
        log "WARNING: Installer completed but 'claude' not found in PATH"
        return 1
    fi
}

# --- Set up persistent config via symlinks ---
setup_persistence() {
    log "Setting up persistent storage at $APPDATA_PATH ..."

    # Determine mount point to wait for
    local wait_mount="/mnt/user"
    case "$APPDATA_PATH" in
        /mnt/disks/*)  wait_mount=$(echo "$APPDATA_PATH" | cut -d/ -f1-4) ;;
        /mnt/cache/*)  wait_mount="/mnt/cache" ;;
    esac

    if ! wait_for_mount "$wait_mount" 120; then
        log "WARNING: Mount not available. Persistence deferred."
        return 1
    fi

    # Already configured correctly?
    if [ -L "$CLAUDE_CONFIG_DIR" ] && [ "$(readlink "$CLAUDE_CONFIG_DIR")" = "$APPDATA_PATH/.claude" ]; then
        log "Persistence already configured."
        return 0
    fi

    mkdir -p "$APPDATA_PATH/.claude"

    # Migrate existing real directory to appdata
    if [ -d "$CLAUDE_CONFIG_DIR" ] && [ ! -L "$CLAUDE_CONFIG_DIR" ]; then
        log "Migrating existing config to appdata..."
        if [ -d "$APPDATA_PATH/.claude" ]; then
            shopt -s dotglob
            cp -an "$CLAUDE_CONFIG_DIR"/* "$APPDATA_PATH/.claude/" 2>/dev/null || true
            shopt -u dotglob
        else
            mv "$CLAUDE_CONFIG_DIR" "$APPDATA_PATH/.claude"
        fi
        rm -rf "$CLAUDE_CONFIG_DIR"
    fi

    ln -sf "$APPDATA_PATH/.claude" "$CLAUDE_CONFIG_DIR"
    log "Linked $CLAUDE_CONFIG_DIR -> $APPDATA_PATH/.claude"

    # Also persist .claude.json if it exists
    if [ -f "$CLAUDE_CONFIG_JSON" ] && [ ! -L "$CLAUDE_CONFIG_JSON" ]; then
        mv "$CLAUDE_CONFIG_JSON" "$APPDATA_PATH/.claude.json"
    fi
    if [ -f "$APPDATA_PATH/.claude.json" ]; then
        ln -sf "$APPDATA_PATH/.claude.json" "$CLAUDE_CONFIG_JSON"
        log "Linked .claude.json to appdata."
    fi
}

# --- Main ---
setup_persistence
install_claude
exit_code=$?

echo ""
if command -v claude &>/dev/null; then
    log "=== Installation Complete ==="
    log "Run 'claude' to start using Claude Code."
    log "Config persisted at: $APPDATA_PATH"
else
    log "=== Installation Incomplete ==="
    log "Claude Code is not yet available."
    log "Check $LOG for details."
    log "Retry: /usr/local/emhttp/plugins/claude-code/scripts/install.sh"
fi

exit $exit_code
]]>
</INLINE>
</FILE>

<!--
================================================================================
  rc.d startup script - runs on boot via Unraid's init system
================================================================================
-->
<FILE Name="/etc/rc.d/rc.&name;" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
#
# Claude Code rc.d startup script for Unraid
#

PLUGIN_NAME="claude-code"
LOGFILE="/var/log/${PLUGIN_NAME}-install.log"
INSTALL_SCRIPT="/usr/local/emhttp/plugins/${PLUGIN_NAME}/scripts/install.sh"

wait_for_network() {
    local max_wait=120 waited=0
    echo "Waiting for network..."
    while [ $waited -lt $max_wait ]; do
        if ping -c 1 -W 2 8.8.8.8 &>/dev/null || ping -c 1 -W 2 1.1.1.1 &>/dev/null; then
            echo "Network available."
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
    done
    echo "WARNING: Network not available after ${max_wait}s"
    return 1
}

do_start() {
    export PATH="/root/.local/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
    export HOME="/root"
    echo "=== Claude Code Startup $(date) ===" > "$LOGFILE"
    wait_for_network >> "$LOGFILE" 2>&1
    "$INSTALL_SCRIPT" >> "$LOGFILE" 2>&1
}

case "$1" in
    start)
        echo "Starting Claude Code setup..."
        # Run in background so we don't block boot
        nohup "$0" _run >/dev/null 2>&1 &
        ;;
    _run)
        do_start
        ;;
    stop)
        echo "Claude Code stopped."
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
]]>
</INLINE>
</FILE>

<!--
================================================================================
  Web UI page - Settings > Utilities > Claude Code
================================================================================
-->
<FILE Name="&plugdir;/&name;.page">
<INLINE>
<![CDATA[
Menu="Utilities"
Title="Claude Code"
Icon="icon-cli"
Desc="Claude Code CLI - AI-powered coding assistant from Anthropic."
Markdown="false"
---
<?php
$plugin = "claude-code";
$cfg_file = "/boot/config/plugins/{$plugin}/{$plugin}.cfg";
$log_file = "/var/log/{$plugin}-install.log";

// Load config
$cfg = file_exists($cfg_file) ? parse_ini_file($cfg_file) : [];
$appdata_path = $cfg['APPDATA_PATH'] ?? '';
if (empty($appdata_path)) {
    $appdata_path = '/mnt/user/appdata/claude-code';
}

// Status checks
$array_started = trim(shell_exec("mountpoint -q /mnt/user 2>/dev/null && echo yes || echo no")) === "yes";
$claude_bin = trim(shell_exec("which claude 2>/dev/null"));
$claude_installed = !empty($claude_bin);
$claude_version = $claude_installed ? htmlspecialchars(trim(shell_exec("claude --version 2>/dev/null")) ?: "Unknown") : "";

$auth_dir = "{$appdata_path}/.claude";
$has_auth = is_dir($auth_dir) && (count(scandir($auth_dir)) > 2); // more than . and ..

$symlink_target = is_link("/root/.claude") ? readlink("/root/.claude") : null;
$symlink_ok = ($symlink_target === "{$appdata_path}/.claude");

$cached_binary = "{$appdata_path}/bin/claude";
$has_cache = file_exists($cached_binary);
?>

<style>
.claude-status { margin: 10px 0; }
.claude-status td { padding: 4px 12px 4px 0; }
.status-ok { color: #4caf50; font-weight: bold; }
.status-warn { color: #ff9800; font-weight: bold; }
.status-err { color: #f44336; font-weight: bold; }
.claude-section { margin: 20px 0; }
.claude-log {
    background: #1a1a2e;
    color: #e0e0e0;
    padding: 12px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 13px;
    max-height: 300px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
}
</style>

<div style="padding: 10px;">

<div class="claude-section">
<h2>Status</h2>
<table class="claude-status">
<tr>
    <td><strong>Claude Code:</strong></td>
    <td><?=$claude_installed
        ? "<span class='status-ok'>Installed - {$claude_version}</span>"
        : "<span class='status-err'>Not installed</span>"?></td>
</tr>
<tr>
    <td><strong>Array:</strong></td>
    <td><?=$array_started
        ? "<span class='status-ok'>Started</span>"
        : "<span class='status-err'>Stopped</span>"?></td>
</tr>
<tr>
    <td><strong>Persistence:</strong></td>
    <td><?=$symlink_ok
        ? "<span class='status-ok'>Active</span>"
        : "<span class='status-warn'>Not linked</span>"?></td>
</tr>
<tr>
    <td><strong>Authentication:</strong></td>
    <td><?=$has_auth
        ? "<span class='status-ok'>Configured</span>"
        : "<span class='status-warn'>Not yet authenticated</span>"?></td>
</tr>
<tr>
    <td><strong>Binary Cache:</strong></td>
    <td><?=$has_cache
        ? "<span class='status-ok'>Cached</span>"
        : "<span class='status-warn'>Not cached (will download on next boot)</span>"?></td>
</tr>
</table>
</div>

<div class="claude-section">
<h2>Settings</h2>
<form method="POST" action="/update.php" target="progressFrame">
    <input type="hidden" name="#file" value="<?=$cfg_file?>">
    <input type="hidden" name="#command" value="/usr/local/emhttp/plugins/claude-code/scripts/install.sh">

    <dl>
        <dt>Appdata Path:</dt>
        <dd>
            <input type="text" name="APPDATA_PATH" value="<?=htmlspecialchars($appdata_path)?>" size="50"
                   title="Directory on your array to store Claude config and cached binary">
        </dd>
    </dl>
    <dl>
        <dt>&nbsp;</dt>
        <dd>
            <input type="submit" value="Apply">
            <input type="button" value="Done" onclick="done()">
        </dd>
    </dl>
</form>
<blockquote class="inline_help">
    <p>Path on your array where Claude Code stores its configuration, authentication tokens, and cached binary.
    This should be on a data drive (not the flash drive) to avoid flash wear.
    The default is auto-detected from your Docker appdata configuration.</p>
</blockquote>
</div>

<?php if (!$claude_installed || !$has_auth): ?>
<div class="claude-section">
<h2>Getting Started</h2>
<ol>
    <li>Make sure the array is started</li>
    <li>Open the Unraid terminal (top-right >_ icon)</li>
    <li>Run: <code>claude</code></li>
    <li>Follow the authentication prompts (browser-based login)</li>
    <li>Your credentials persist automatically across reboots</li>
</ol>
</div>
<?php endif; ?>

<div class="claude-section">
<h2>Actions</h2>
<form method="POST" action="/update.php" target="progressFrame" style="display:inline;">
    <input type="hidden" name="#command" value="/usr/local/emhttp/plugins/claude-code/scripts/install.sh">
    <input type="submit" value="Reinstall / Update">
</form>
&nbsp;
<input type="button" value="View Log" onclick="toggleLog()">
</div>

<div id="claude-log-section" class="claude-section" style="display:none;">
<h2>Install Log</h2>
<div class="claude-log" id="claude-log-content">Loading...</div>
</div>

</div>

<script>
function toggleLog() {
    var section = document.getElementById('claude-log-section');
    if (section.style.display === 'none') {
        section.style.display = 'block';
        loadLog();
    } else {
        section.style.display = 'none';
    }
}

function loadLog() {
    $.get('/plugins/claude-code/scripts/readlog.sh', function(data) {
        document.getElementById('claude-log-content').textContent = data;
    }).fail(function() {
        document.getElementById('claude-log-content').textContent = 'No log file found.';
    });
}
</script>
]]>
</INLINE>
</FILE>

<!--
================================================================================
  Log reader helper (called via AJAX from the web UI)
================================================================================
-->
<FILE Name="&plugdir;/scripts/readlog.sh" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
echo "Content-Type: text/plain"
echo ""
if [ -f /var/log/claude-code-install.log ]; then
    tail -100 /var/log/claude-code-install.log
else
    echo "No install log found."
fi
]]>
</INLINE>
</FILE>

<!--
================================================================================
  Post-install: add startup entry to go file and run initial install
================================================================================
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Add rc.d startup to go file if not present
GO_FILE="/boot/config/go"
RC_CMD="/etc/rc.d/rc.claude-code start"

if ! grep -q "rc.claude-code" "$GO_FILE" 2>/dev/null; then
    echo "" >> "$GO_FILE"
    echo "# Start Claude Code plugin" >> "$GO_FILE"
    echo "$RC_CMD" >> "$GO_FILE"
fi

# Run install now (on first plugin install, not on every boot)
# The rc.d script handles boot-time installs via the go file
if [ ! -f /var/log/claude-code-install.log ]; then
    /usr/local/emhttp/plugins/claude-code/scripts/install.sh 2>&1 | tee /var/log/claude-code-install.log
    echo ""
    echo "-----------------------------------------------------------"
    echo " Claude Code plugin v2026.04.04 installed!"
    echo ""
    echo " Usage:  Open terminal and run: claude"
    echo " Web UI: Settings > Utilities > Claude Code"
    echo "-----------------------------------------------------------"
fi
]]>
</INLINE>
</FILE>

<!--
================================================================================
  Removal script - clean uninstall
================================================================================
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
echo "Removing Claude Code plugin..."

# Stop any running processes
/etc/rc.d/rc.claude-code stop 2>/dev/null

# Remove startup entry from go file
sed -i '/# Start Claude Code plugin/d' /boot/config/go 2>/dev/null
sed -i '/rc\.claude-code/d' /boot/config/go 2>/dev/null

# Remove rc.d script
rm -f /etc/rc.d/rc.claude-code

# Remove Claude Code binary (native install locations)
rm -f /root/.local/bin/claude
rm -f /usr/local/bin/claude

# Remove config symlinks (but NOT the appdata targets)
[ -L /root/.claude ] && rm -f /root/.claude
[ -L /root/.claude.json ] && rm -f /root/.claude.json

# Remove native installer's local directory if it exists
rm -rf /root/.claude/local 2>/dev/null

# Remove plugin runtime files
rm -rf /usr/local/emhttp/plugins/claude-code

# Remove install log
rm -f /var/log/claude-code-install.log

echo ""
echo "Claude Code plugin removed."
echo ""
echo "Preserved (delete manually if desired):"
echo "  Config:  /boot/config/plugins/claude-code/"
echo "  Appdata: (see config for path - contains auth tokens and cached binary)"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
